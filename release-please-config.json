{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "include-v-in-release-name": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "bootstrap-sha": "8e6001b1231a67c8d141ca6bbf0acfe1f5b9ba5d",
  "packages": {
    ".": {
      "component": "NosoGraph",
      "package-name": "med-research",
      "changelog-path": "CHANGELOG.md",
      "changelog-sections": [
        { "type": "feat", "section": "Added" },
        { "type": "fix", "section": "Fixed" },
        { "type": "perf", "section": "Performance" },
        { "type": "refactor", "section": "Changed" },
        { "type": "revert", "section": "Reverted" },
        { "type": "build", "section": "Build", "hidden": true },
        { "type": "ci", "section": "Continuous Integration", "hidden": true },
        { "type": "chore", "section": "Miscellaneous", "hidden": true },
        { "type": "deps", "section": "Dependencies", "hidden": true },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "style", "section": "Styles", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true }
      ],
      "extra-files": [
        { "type": "generic", "path": "CITATION.cff" },
        { "type": "generic", "path": "docs/generated/public-status.yaml" },
        { "type": "json", "path": "codemeta.json", "jsonpath": "$.version" }
      ]
    }
  }
}
