# Medical Research Platform — environment variables
# Copy to .env and adjust for local development or deployment.

# Web API server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Comma-separated allowed browser origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional API key (empty = auth disabled for local development).
# REQUIRED in production: set a strong secret and keep DEBUG=false.
API_KEY=

# Contact email for NCBI Entrez (PubMed). Required for compliant literature mining.
ENTREZ_EMAIL=researcher@example.com

# Rate limiting (requests per window per client IP)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Max request body size in bytes (default 1 MB)
MAX_REQUEST_BODY_BYTES=1048576

# Celery / Redis (async jobs)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Pipeline caching
USE_CACHE=true

# Evidence Workspace history
WORKSPACE_DB_PATH=data/evidence_workspace.sqlite3

# LLM extraction (Evidence / LLM Extractor modules)
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1
# LLM_EXTRACTOR_MODEL=gpt-4o-mini
