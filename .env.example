# NosoGraph (med-research) — environment variables
# Copy to .env and adjust for local development or deployment.
#
# Product name: NosoGraph — The Open Computational Map of Human Disease
# Package/CLI compatibility alias: med-research / med_research
#
#   cp .env.example .env

# Web API server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Comma-separated allowed browser origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Optional API key (empty = auth disabled for local development).
# REQUIRED in production: set a strong secret and keep DEBUG=false.
API_KEY=

# Researcher session authentication (Evidence Workspace)
# local = signed HttpOnly cookies via /api/auth/login
# proxy = trust X-Authenticated-User from AUTH_TRUSTED_PROXY_IPS only
AUTH_MODE=local
AUTH_SESSION_SECRET=
# JSON map or alice=secret,bob=secret — local dev only; never use plaintext in production
LOCAL_AUTH_USERS=
# Comma-separated proxy IPs allowed to set X-Forwarded-For / X-Authenticated-User
AUTH_TRUSTED_PROXY_IPS=

# OpenAPI docs (/api/docs). Defaults to enabled when DEBUG=true, disabled otherwise.
OPENAPI_ENABLED=

# Contact email for NCBI Entrez (PubMed). Required for compliant literature mining.
ENTREZ_EMAIL=researcher@example.com

# Rate limiting (requests per window per client IP)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
# When true, deny requests if the Redis rate-limit backend is unavailable
RATE_LIMIT_FAIL_CLOSED=false
# Optional dedicated Redis URL for rate limiting (defaults to CELERY_BROKER_URL)
REDIS_RATE_LIMIT_URL=

# Max request body size in bytes (default 10 MB when unset)
MAX_REQUEST_BODY_BYTES=10485760

# Celery / Redis (async jobs)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Pipeline caching
USE_CACHE=true

# Evidence Workspace history
WORKSPACE_DB_PATH=data/evidence_workspace.sqlite3
WORKSPACE_PUBLIC_URL=http://localhost:8000
WORKSPACE_REVIEW_LINK_SECRET=

# Universal biomedical canonical store
BIOMEDICAL_DB_PATH=data/biomedical.sqlite3

# Dashboard Content-Security-Policy (off | report-only | enforce)
# DASHBOARD_CSP=true is shorthand for enforce mode
DASHBOARD_CSP=false
DASHBOARD_CSP_MODE=off

# LLM extraction (Evidence / LLM Extractor modules)
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1
# LLM_EXTRACTOR_MODEL=gpt-4o-mini

# Optional SMTP alerts for Celery Beat digests (worker/beat services)
# ALERT_SMTP_HOST=
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USERNAME=
# ALERT_SMTP_PASSWORD=
# ALERT_SMTP_FROM=
# ALERT_SMTP_USE_TLS=true

# Docker build: set to 1 to skip disease validate during image build (faster dev builds)
# DOCKER_SKIP_DISEASE_VALIDATE=0
