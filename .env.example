# Medical Research Platform — environment variables
# Copy to .env and adjust for local development or deployment.

# Web API server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Comma-separated allowed browser origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional API key (empty = auth disabled). When set, clients must send X-API-Key.
API_KEY=

# Rate limiting (requests per window per client IP)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Celery / Redis (async jobs)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Pipeline caching
USE_CACHE=true

# Evidence Workspace history
WORKSPACE_DB_PATH=data/evidence_workspace.sqlite3

# Optional external integrations
# OPENAI_API_KEY=
# NCBI_API_KEY=
# ENTREZ_EMAIL=
