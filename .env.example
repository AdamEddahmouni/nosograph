# ── Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Default: http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Celery / Redis ────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Cache ─────────────────────────────────────────────────────────────────
USE_CACHE=true

# ── External APIs ─────────────────────────────────────────────────────────
# OpenAI API key for LLM-powered evidence extraction
OPENAI_API_KEY=
# Optional: custom OpenAI-compatible API base URL
OPENAI_API_BASE=
# Model to use for evidence extraction (default: gpt-4o-mini)
LLM_EXTRACTOR_MODEL=gpt-4o-mini
# Email for NCBI Entrez API (required for PubMed queries)
ENTREZ_EMAIL=

# ── Security ────────────────────────────────────────────────────────────────
# API key for protecting write/mutation endpoints (optional, dev mode if unset)
API_KEY=
# Rate limiting: requests per window per client IP (default: 60 req / 60s)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
